{
  "name": "fixitnow",
  "version": "1.0.0",
  "private": true,
  "description": "FixitNow - Appliance Maintenance and Service Management System",
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "db:sync": "npm --prefix server run db:sync",
    "db:reset": "npm --prefix server run db:reset",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "email:test": "npm --prefix server run email:test --",
    "test": "npm --prefix server test",
    "lint": "npm --prefix server run lint && npm --prefix client run lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}